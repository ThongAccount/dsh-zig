{
  "schema": "conformance.scenario.v1",
  "category": "web",
  "description": "Basic auth — valid credentials authenticate, wrong/missing credentials yield 401 with Basic challenge.",
  "target": "node",
  "entry": "../conformance/web-server.ts",
  "function": "runWebOp",
  "scenarios": [
    {
      "id": "web.auth.basic-ok",
      "description": "Valid basic credentials authenticate.",
      "input": {
        "op": "web.auth.basic",
        "authorization": "Basic dXNlcjpwYXNz",
        "expectedUser": "user",
        "expectedPass": "pass"
      },
      "expected": { "authenticated": true }
    },
    {
      "id": "web.auth.basic-wrong",
      "description": "Wrong credentials → 401.",
      "input": {
        "op": "web.auth.basic",
        "authorization": "Basic dXNlcjp3cm9uZw==",
        "expectedUser": "user",
        "expectedPass": "pass"
      },
      "expected": { "ok": false, "error": "unauthorized", "exitCode": 401 }
    },
    {
      "id": "web.auth.basic-missing",
      "description": "Missing Authorization header → 401 with Basic challenge.",
      "input": {
        "op": "web.auth.basic",
        "authorization": null,
        "expectedUser": "user",
        "expectedPass": "pass"
      },
      "expected": { "ok": false, "error": "unauthorized", "exitCode": 401, "challenge": "Basic" }
    }
  ]
}
